NEXT_PUBLIC_SITE_URL=https://www.asiaoil.com.tr
NILASYA_SESSION_SECRET=
NILASYA_ADMIN_PASSWORD=
NOTIFY_EMAIL=export@asiaoil.com.tr
RESEND_API_KEY=
NOTIFY_FROM=
# Firestore: either a service account JSON, or FIREBASE_USE_ADC=1 on Google Cloud (set automatically on Cloud Run).
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_USE_ADC=
FIREBASE_PROJECT_ID=ajansonline
FIREBASE_WEB_API_KEY=
FIREBASE_STORAGE_BUCKET=
# Only for `next start` on a local machine without Firestore. Never set in production.
NILASYA_ALLOW_FILE_STORE=
