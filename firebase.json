{
  "hosting": {
    "site": "nilasyayag",
    "source": ".",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "data/**", "tests/**", "scripts/**"],
    "headers": [
      {
        "source": "/media/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(webp|png|jpg|jpeg|ico|svg|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "frameworksBackend": {
      "region": "europe-west1",
      "memory": "1GiB"
    }
  }
}
